# AgriRover Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS — Allowed Frontend Origins (comma-separated, e.g. http://localhost:3000,http://192.168.1.100:3000)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Phase 3: ML Model Integration (PyTorch EfficientNet-B0)
MODEL_DIR=models/plant_disease
MODEL_PATH=models/plant_disease/best_model.pth
CONFIDENCE_THRESHOLD=0.60

