# AgriRover Raspberry Pi 5 USB Webcam Configuration
CAMERA_HOST=0.0.0.0
CAMERA_PORT=5001

# Camera Hardware Settings
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_JPEG_QUALITY=80

# Allowed Frontend Origins for CORS (comma-separated, e.g. http://192.168.1.100:3000)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
